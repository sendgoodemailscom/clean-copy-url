{
  "manifest_version": 3,
  "name": "Clean Copy URL",
  "version": "1.4",
  "description": "Copy the current tab's URL with tracking parameters (UTM, gclid, fbclid & more) stripped. Cmd+Shift+K",
  "permissions": [
    "activeTab",
    "clipboardWrite",
    "scripting",
    "tabs"
  ],
  "host_permissions": [
    "<all_urls>"
  ],
  "background": {
    "service_worker": "background.js"
  },
  "content_scripts": [
    {
      "matches": ["<all_urls>"],
      "js": ["content.js"],
      "run_at": "document_idle"
    }
  ],
  "commands": {
    "copy-clean-url": {
      "suggested_key": {
        "mac": "Command+Shift+K",
        "default": "Ctrl+Shift+K"
      },
      "description": "Copy clean URL to clipboard"
    }
  },
  "action": {
    "default_popup": "popup.html",
    "default_title": "Clean Copy URL",
    "default_icon": {
      "16": "icon16.png",
      "32": "icon32.png",
      "48": "icon48.png",
      "128": "icon128.png"
    }
  },
  "icons": {
    "16": "icon16.png",
    "32": "icon32.png",
    "48": "icon48.png",
    "128": "icon128.png"
  }
}
